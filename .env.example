# API keys
NEWSAPI_KEY=
GNEWS_KEY=
GOOGLE_API_KEY=
GOOGLE_API_KEY2=
GOOGLE_API_KEY3=
GOOGLE_API_KEY4=
GOOGLE_API_KEY5=
GEMINI_KEY=

# Database
DB_TYPE=sqlite
SQLITE_PATH=./data/supply_chain.db
POSTGRES_URL=postgresql://postgres:password@localhost:5432/supply_chain

# Scheduler
FETCH_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_SOURCE=20

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_WINDOW_SIZE=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ingestion.log

# Notifications
SLACK_WEBHOOK_URL=

# SMTP alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ALERT_EMAIL_TO=
ALERT_SCORE_THRESHOLD=50

# Service URL
BACKEND_URL=http://localhost:8000
